---
import type { Entry, Lang } from '../data/cv';
import { t, ui } from '../lib/i18n';
import Period from './Period.astro';
import Todo from './Todo.astro';

interface Props {
	entry: Entry;
	lang: Lang;
	compact?: boolean;
}

const { entry, lang, compact = false } = Astro.props;
const s = ui[lang];
---

<article class:list={['entry', { compact }]}>
	<div class="when label">
		{entry.periods.map((p) => <Period period={p} lang={lang} />)}
	</div>
	<div class="what">
		<h3>
			{
				entry.org === null ? (
					<Todo lang={lang} />
				) : entry.url ? (
					<a href={entry.url} rel="noopener noreferrer" target="_blank">
						{entry.org}
						<span class="visually-hidden"> ({s.newTab})</span>
					</a>
				) : (
					entry.org
				)
			}
		</h3>
		<p class="role">{t(entry.role, lang)}</p>
		{entry.context && <p class="context label">{t(entry.context, lang)}</p>}
		{entry.summary && <p class="summary">{t(entry.summary, lang)}</p>}
		{
			entry.items.length > 0 && (
				<ul>
					{entry.items.map((item) => (
						<li>{t(item, lang)}</li>
					))}
				</ul>
			)
		}
		{
			entry.stack && (
				<ul class="stack" aria-label="Stack">
					{entry.stack.map((x) => (
						<li>{x}</li>
					))}
				</ul>
			)
		}
	</div>
</article>

<style>
	.entry {
		display: grid;
		grid-template-columns: minmax(9rem, 3fr) 9fr;
		gap: var(--space-2xs) var(--gutter);
		padding-block: var(--space-m);
		border-top: var(--hairline) solid var(--c-border);
	}

	.when {
		display: flex;
		flex-direction: column;
		gap: var(--space-3xs);
		padding-top: 0.35em;
		color: var(--c-text);
	}

	h3 {
		margin: 0;
		font-size: var(--step-2);
	}

	.compact h3 {
		font-size: var(--step-1);
	}

	.role {
		margin: 0.3em 0 0;
		font-weight: 600;
	}

	.context {
		margin: 0.2em 0 0;
	}

	.summary {
		margin: var(--space-xs) 0 0;
		max-width: var(--measure);
		color: var(--c-muted);
	}

	ul {
		margin: var(--space-xs) 0 0;
		padding-left: 1.3em;
		max-width: var(--measure);
	}

	li + li {
		margin-top: 0.3em;
	}

	ul:not(.stack) li::marker {
		content: '▪  ';
		color: var(--c-accent);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3xs);
		padding: 0;
		list-style: none;
	}

	.stack li {
		margin: 0;
		padding: 0.1em 0.5em;
		border: var(--hairline) solid var(--c-border);
		border-radius: var(--radius);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		color: var(--c-muted);
	}

	@media (max-width: 48rem) {
		.entry {
			grid-template-columns: 1fr;
		}

		.when {
			flex-direction: row;
			flex-wrap: wrap;
			gap: var(--space-3xs) var(--space-s);
			padding-top: 0;
		}
	}

	@media print {
		.entry {
			grid-template-columns: 8rem 1fr;
			padding-block: 0.6em;
		}

		h3 {
			font-size: 13pt;
		}
	}
</style>
