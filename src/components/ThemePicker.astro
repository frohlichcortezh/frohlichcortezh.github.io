---
import type { Lang } from '../data/cv';
import { ui } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const s = ui[lang];
---

<div class="theme-picker" data-theme-picker data-resolved={JSON.stringify(s.resolved)} hidden>
	<label for="tema">{s.theme}</label>
	<select id="tema">
		<option value="auto">{s.themes.auto}</option>
		<option value="light">{s.themes.light}</option>
		<option value="dark">{s.themes.dark}</option>
		<option value="contrast">{s.themes.contrast}</option>
	</select>
</div>

<script>
	type Choice = 'auto' | 'light' | 'dark' | 'contrast';
	type ThemeApi = { apply(): void; read(): Choice };
	const api = (window as Window & { cvTheme?: ThemeApi }).cvTheme;

	const sync = () => {
		const choice = api?.read() ?? 'auto';
		const resolved = (document.documentElement.dataset.theme ?? 'light').replace(/^contrast-.*/, 'contrast');
		for (const picker of document.querySelectorAll<HTMLElement>('[data-theme-picker]')) {
			const select = picker.querySelector('select');
			if (!select) continue;
			const labels = JSON.parse(picker.dataset.resolved ?? '{}') as Record<string, string>;
			select.value = choice;
			const auto = select.querySelector<HTMLOptionElement>('option[value="auto"]');
			if (auto) auto.textContent = `Auto (${labels[resolved] ?? resolved})`;
		}
	};

	if (api) {
		for (const picker of document.querySelectorAll<HTMLElement>('[data-theme-picker]')) {
			picker.hidden = false;
			picker.querySelector('select')?.addEventListener('change', (event) => {
				const value = (event.currentTarget as HTMLSelectElement).value;
				try {
					if (value === 'auto') localStorage.removeItem('cv-theme');
					else localStorage.setItem('cv-theme', value);
				} catch {}
				api.apply();
			});
		}
		document.addEventListener('cv:theme', sync);
		sync();
	}
</script>

<style>
	.theme-picker {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		font-family: var(--font-mono);
		font-size: var(--step--2);
	}

	.theme-picker[hidden] {
		display: none;
	}

	label {
		color: var(--c-muted);
	}

	select {
		min-height: 2rem;
		padding: 0.25em 1.8em 0.25em 0.6em;
		border: var(--hairline) solid var(--c-border);
		border-radius: var(--radius);
		background-color: var(--c-surface);
		background-image: linear-gradient(45deg, transparent 50%, var(--c-text) 50%),
			linear-gradient(135deg, var(--c-text) 50%, transparent 50%);
		background-position:
			right 0.85em top 55%,
			right 0.55em top 55%;
		background-size: 0.3em 0.3em;
		background-repeat: no-repeat;
		color: var(--c-text);
		font: inherit;
		appearance: none;
		cursor: pointer;
	}

	select:hover {
		border-color: var(--c-text);
	}

	@media (forced-colors: active) {
		select {
			appearance: auto;
			background-image: none;
		}
	}
</style>
